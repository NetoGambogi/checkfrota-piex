<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.PerfilPage"
             x:DataType="viewmodels:PerfilViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Perfil">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Perfil"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <Grid Grid.Row="1" Padding="24" RowDefinitions="*,Auto">

            <VerticalStackLayout Grid.Row="0" Spacing="24" VerticalOptions="Start">

                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                    <Border WidthRequest="88"
                            HeightRequest="88"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0">
                        <Grid>
                            <BoxView Color="{DynamicResource HeaderBg}" />
                            <Label Text="{Binding Initials}"
                                   IsVisible="{Binding NoAvatar}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image Source="{Binding AvatarUrl}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding HasAvatar}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding UserName}"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="20"
                               HorizontalOptions="Center" />

                        <Border BackgroundColor="{DynamicResource CardBg}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,4"
                                HorizontalOptions="Center">
                            <Label Text="{Binding RoleDisplay}"
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontAttributes="Bold"
                                   FontSize="12" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />

                <Button Text="Sair"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="{DynamicResource DangerSolid}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48" />

            </VerticalStackLayout>

            <Label Grid.Row="1"
                   Text="{Binding AppVersion}"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0" />

        </Grid>

    </Grid>

</ContentPage>
