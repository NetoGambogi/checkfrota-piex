<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.MotoristaHomePage"
             x:DataType="viewmodels:MotoristaHomeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Motorista">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Motorista"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,20,20,20" Spacing="14">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       Text="{Binding Saudacao}"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        Stroke="Transparent"
                        Padding="8,3"
                        VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource WarningBg}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding StatusTexto}" FontSize="11" FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Success}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

            <shared:LoadingState IsBusy="{Binding ShowLoadingViagem}"
                                 Message="Carregando sua viagem…"
                                 Margin="0,24" />

            <!-- Viagem em andamento -->
            <Border BackgroundColor="{DynamicResource HeaderBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="18"
                    IsVisible="{Binding HasViagemAtual}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="VIAGEM EM ANDAMENTO"
                               TextColor="White"
                               Opacity="0.7"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ViagemAtual.KmLabel}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding ViagemAtual.RotaNome}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="18"
                           LineBreakMode="TailTruncation"
                           Margin="0,6,0,0" />
                    <Label Text="{Binding ViagemAtual.Trajeto}"
                           TextColor="White"
                           FontSize="14" />
                    <Label Text="{Binding ViagemAtual.Subtitulo}"
                           TextColor="White"
                           Opacity="0.7"
                           FontSize="13" />
                    <Label Text="{Binding ViagemAtual.PeriodoLabel}"
                           TextColor="White"
                           Opacity="0.7"
                           FontSize="13" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,14,0,0">
                        <Button Grid.Column="0"
                                Text="Concluir viagem"
                                Command="{Binding ConcluirViagemAtualCommand}"
                                BackgroundColor="{DynamicResource Accent}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="46" />
                        <Button Grid.Column="1"
                                Text="Editar"
                                Command="{Binding EditarViagemAtualCommand}"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                BorderColor="White"
                                BorderWidth="1"
                                CornerRadius="10"
                                HeightRequest="46"
                                Padding="18,0" />
                    </Grid>

                    <Button Text="Reportar problema na viagem"
                            Command="{Binding RegistrarOcorrenciaCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="40"
                            Margin="0,4,0,0" />

                    <Label Text="{Binding OutrasViagensLabel}"
                           TextColor="White"
                           Opacity="0.7"
                           FontSize="12"
                           Margin="0,8,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirViagensCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Sem viagem em andamento -->
            <Border BackgroundColor="{DynamicResource HeaderBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="18"
                    IsVisible="{Binding SemViagemAtual}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nenhuma viagem em andamento"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="18" />
                    <Label Text="Ao sair para uma entrega, inicie a viagem e informe o km do hodômetro."
                           TextColor="White"
                           Opacity="0.7"
                           FontSize="13" />
                    <Button Text="Iniciar viagem"
                            Command="{Binding IniciarViagemCommand}"
                            BackgroundColor="{DynamicResource Accent}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="46"
                            Margin="0,14,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Ações"
                   TextColor="{DynamicResource TextPrimary}"
                   FontAttributes="Bold"
                   FontSize="20"
                   Margin="0,8,0,0" />

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16"
                    IsVisible="{Binding HasViagemAtual}">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IniciarViagemCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Rota}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Iniciar outra viagem"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Rota, veículo e km de saída"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RegistrarAbastecimentoCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.CategoriaCombustivel}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Registrar abastecimento"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Litros, valor e km do hodômetro"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirViagensCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Viagem}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Minhas viagens"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Em andamento e concluídas"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirAbastecimentosCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Movimentacoes}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Meus abastecimentos"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Histórico do que você registrou"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirOcorrenciasCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Alerta}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Minhas ocorrências"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Problemas relatados e se já foram resolvidos"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

        </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
