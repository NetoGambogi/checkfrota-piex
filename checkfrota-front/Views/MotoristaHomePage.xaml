<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             x:Class="checkfrota_front.Views.MotoristaHomePage"
             x:DataType="viewmodels:MotoristaHomeViewModel"
             Title="Motorista">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
    <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="{Binding UserName}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="MOTORISTA"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="{Binding StatusCor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,4"
                        VerticalOptions="Center">
                    <Label Text="{Binding StatusTexto}"
                           TextColor="White"
                           FontSize="12"
                           FontAttributes="Bold" />
                </Border>
            </Grid>

            <Border BackgroundColor="#0B1F3A"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Sua rota de hoje"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="{Binding RotaDescricao}" TextColor="White" />
                    <Label Text="{Binding EntregaDescricao}" TextColor="White" />
                    <Label Text="{Binding StatusRota}" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Ações do motorista -->
            <Grid RowDefinitions="120,120"
                  ColumnDefinitions="*,*"
                  RowSpacing="12"
                  ColumnSpacing="12">

                <Button Grid.Row="0" Grid.Column="0"
                        Text="Minhas Viagens"
                        Command="{Binding AbrirViagensCommand}"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F2937}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Button Grid.Row="0" Grid.Column="1"
                        Text="Registrar Hodômetro"
                        Command="{Binding AbrirHodometroCommand}"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F2937}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Button Grid.Row="1" Grid.Column="0"
                        Text="Notificações"
                        Command="{Binding AbrirNotificacoesCommand}"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F2937}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />


                <Button Grid.Row="1" Grid.Column="1"
                        Text="Meu Perfil"
                        Command="{Binding AbrirPerfilCommand}"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F2937}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            </Grid>

            <Button Text="Sair"
                    Command="{Binding LogoutCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
