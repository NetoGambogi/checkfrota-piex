<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.FrotaHomePage"
             x:DataType="viewmodels:FrotaHomeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Frota">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Frota"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,20,20,20" Spacing="14">

            <Label Text="Cadastros"
                   TextColor="{DynamicResource TextPrimary}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirVeiculosCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Frota}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Veículos"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Placa, modelo e quilometragem"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirManutencoesCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Manutencao}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Manutenções"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Preventivas e corretivas, lançadas no financeiro"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirRotasCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            Padding="0"
                            BackgroundColor="{DynamicResource AccentSoftBg}">
                        <Label Text="{x:Static helpers:IconFont.Rota}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource Accent}"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Rotas de viagem"
                               TextColor="{DynamicResource TextPrimary}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Origem, destino e km aproximado"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{x:Static helpers:IconFont.ChevronDireita}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           VerticalOptions="Center" />

                </Grid>
            </Border>

        </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
