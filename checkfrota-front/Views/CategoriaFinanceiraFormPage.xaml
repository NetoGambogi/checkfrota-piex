<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.CategoriaFinanceiraFormPage"
             x:DataType="viewmodels:CategoriaFinanceiraFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Categoria financeira">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="{Binding PageTitle}"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Danger}"
                       FontSize="13" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tipo" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Despesa"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectDespesaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="despesa">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="receita">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="Receita"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectReceitaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="receita">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="despesa">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Nome" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Nome}"
                               Placeholder="Ex: Combustível"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Descrição" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Descricao}"
                               Placeholder="Ex: Abastecimento dos veículos"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Ícone" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Icones}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedIcone}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Salvar"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

                <Button Text="Excluir categoria"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Danger}"
                        FontAttributes="Bold"
                        BorderColor="{DynamicResource Danger}"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
