<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.FinanciamentoFormPage"
             x:DataType="viewmodels:FinanciamentoFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="White"
             Title="Novo financiamento">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="FormTitle">#1F2430</Color>
            <Color x:Key="FormSubtitle">#6B7280</Color>
            <Color x:Key="FormFieldBg">#F8F9FB</Color>
            <Color x:Key="FormFieldBorder">#E2E4E9</Color>
            <Color x:Key="FormPrimary">#3D4FE0</Color>
            <Color x:Key="FormDanger">#DC2626</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Novo financiamento"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Label Text="Lance uma compra parcelada (ex: veículo financiado) e as despesas futuras de cada parcela serão geradas automaticamente como pendentes."
                       TextColor="{StaticResource FormSubtitle}"
                       FontSize="13" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource FormDanger}"
                       FontSize="13" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Descrição" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Descricao}"
                               Placeholder="Ex: Caminhão Volvo FH 2024"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoria (despesa)" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Categorias}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedCategoria}"
                                TextColor="{StaticResource FormTitle}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Forma de pagamento" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding FormasPagamento}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedFormaPagamento}"
                                TextColor="{StaticResource FormTitle}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Valor da parcela (R$)" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding ValorParcela}"
                               Placeholder="0,00"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Quantidade de parcelas" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                        <Border BackgroundColor="{StaticResource FormFieldBg}"
                                Stroke="{StaticResource FormFieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Text="{Binding QuantidadeParcelas}"
                                   Placeholder="Ex: 48"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Dia do vencimento" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                        <Border BackgroundColor="{StaticResource FormFieldBg}"
                                Stroke="{StaticResource FormFieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Text="{Binding DiaVencimento}"
                                   Placeholder="Ex: 10"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Mês da primeira parcela" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <DatePicker Date="{Binding DataInicio}"
                                    TextColor="{StaticResource FormTitle}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Salvar financiamento"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource FormPrimary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
