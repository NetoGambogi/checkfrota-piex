<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.MovimentacaoFinanceiraManagementPage"
             x:DataType="viewmodels:MovimentacaoFinanceiraManagementViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Lançamentos">

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Financeiro"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,12" Spacing="10" BackgroundColor="{DynamicResource PageBg}">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Lançamentos financeiros"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource FieldBg}"
                        Stroke="{DynamicResource FieldBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,7">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFiltrosCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Filtros" TextColor="{DynamicResource TextPrimary}" FontSize="13" VerticalOptions="Center" />
                        <Label Text="{x:Static helpers:IconFont.ChevronDireita}"
                               FontFamily="FontAwesomeSolid"
                               TextColor="{DynamicResource TextSecondary}"
                               FontSize="11"
                               Rotation="{Binding FiltrosChevronRotation}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{DynamicResource FieldBg}"
                    Stroke="{DynamicResource FieldBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="46"
                    Padding="4,0">
                <SearchBar Placeholder="Buscar lançamento..."
                           Text="{Binding SearchText}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

            <Label Text="{Binding FiltrosResumoLabel}"
                   IsVisible="{Binding IsFiltrosColapsado}"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="12" />

            <VerticalStackLayout IsVisible="{Binding IsFiltrosExpandido}" Spacing="10">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Todos" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoTodosCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoTodosSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoTodosSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Entradas" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoEntradaCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoEntradaSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoEntradaSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Saídas" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoSaidaCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoSaidaSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoSaidaSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Todos" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusTodosCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusTodosSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusTodosSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Pendentes" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusPendenteCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPendenteSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPendenteSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Pagos" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusPagoCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPagoSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPagoSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Border BackgroundColor="{DynamicResource CardBg}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    Padding="14">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Período" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" FontSize="14" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Vencimento"
                                CornerRadius="8"
                                HeightRequest="36"
                                FontSize="12"
                                Command="{Binding SelectCampoDataVencimentoCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCampoDataVencimentoSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCampoDataVencimentoSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="Pagamento"
                                CornerRadius="8"
                                HeightRequest="36"
                                FontSize="12"
                                Command="{Binding SelectCampoDataPagamentoCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCampoDataPagamentoSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCampoDataPagamentoSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="De" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                            <Border BackgroundColor="{DynamicResource PageBg}"
                                    Stroke="{DynamicResource FieldBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="42"
                                    Padding="10,0">
                                <DatePicker Date="{Binding DataInicio}"
                                            Format="dd/MM/yyyy"
                                            FontSize="13"
                                            TextColor="{DynamicResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Até" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                            <Border BackgroundColor="{DynamicResource PageBg}"
                                    Stroke="{DynamicResource FieldBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="42"
                                    Padding="10,0">
                                <DatePicker Date="{Binding DataFim}"
                                            Format="dd/MM/yyyy"
                                            FontSize="13"
                                            TextColor="{DynamicResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <Label Text="Carregando lançamentos…"
                   IsVisible="{Binding ShowInitialLoading}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Text="Nenhum lançamento encontrado."
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadMovimentacoesCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="MovimentacoesCollectionView" ItemsSource="{Binding Movimentacoes}" Margin="20,0,20,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MovimentacaoFinanceiraRowViewModel">
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,8,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.EditMovimentacaoCommand, Source={x:Reference MovimentacoesCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="Ellipse"
                                            Stroke="Transparent"
                                            Padding="0">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource DangerSoftBg}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding IconGlyph}"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerSoftFg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Descricao}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding CategoriaNome}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="12" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding DataVencimentoFormatada}"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   FontSize="12" />
                                            <Label Text="{x:Static helpers:IconFont.Anexo}"
                                                   FontFamily="FontAwesomeSolid"
                                                   IsVisible="{Binding HasComprovante}"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding ValorFormatado}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerSoftFg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,3" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPago}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPago}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource WarningBg}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPago}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPago}" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <Label Text="{Binding ParcelaLabel}"
                                               IsVisible="{Binding HasParcelaLabel}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="11"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <Border HeightRequest="56"
                    WidthRequest="56"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    BackgroundColor="{DynamicResource Accent}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddMovimentacaoCommand}" />
                </Border.GestureRecognizers>

                <Label Text="+"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="30"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-4,0,0" />
            </Border>

        </Grid>

    </Grid>

</ContentPage>
