<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.MovimentacaoFinanceiraManagementPage"
             x:DataType="viewmodels:MovimentacaoFinanceiraManagementViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Lançamentos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="FinTitle">#1F2430</Color>
            <Color x:Key="FinSubtitle">#6B7280</Color>
            <Color x:Key="FinCardBg">#F1F2F4</Color>
            <Color x:Key="FinPrimary">#3D4FE0</Color>
            <Color x:Key="FinFieldBg">#F8F9FB</Color>
            <Color x:Key="FinFieldBorder">#E2E4E9</Color>
            <Color x:Key="FinDanger">#DC2626</Color>
            <Color x:Key="FinEntradaBg">#DCFCE7</Color>
            <Color x:Key="FinEntradaFg">#16A34A</Color>
            <Color x:Key="FinSaidaBg">#FBE3E3</Color>
            <Color x:Key="FinSaidaFg">#D9534F</Color>
            <Color x:Key="FinStatusPagoBg">#DCFCE7</Color>
            <Color x:Key="FinStatusPagoFg">#16A34A</Color>
            <Color x:Key="FinStatusPendenteBg">#FEF3C7</Color>
            <Color x:Key="FinStatusPendenteFg">#B45309</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Financeiro"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,12" Spacing="12" BackgroundColor="White">

            <Label Text="Lançamentos financeiros"
                   TextColor="{StaticResource FinTitle}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Border BackgroundColor="{StaticResource FinFieldBg}"
                    Stroke="{StaticResource FinFieldBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="46"
                    Padding="4,0">
                <SearchBar Placeholder="Buscar lançamento..."
                           Text="{Binding SearchText}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource FinDanger}"
                   FontSize="13" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Todos" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoTodosCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoTodosSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinPrimary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoTodosSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Entradas" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoEntradaCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoEntradaSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinPrimary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoEntradaSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Saídas" CornerRadius="10" HeightRequest="42" FontSize="13"
                        Command="{Binding SelectTipoSaidaCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoSaidaSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinPrimary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTipoSaidaSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Todos" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusTodosCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusTodosSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusTodosSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinSubtitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Pendentes" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusPendenteCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPendenteSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPendenteSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinSubtitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Pagos" CornerRadius="10" HeightRequest="38" FontSize="12"
                        Command="{Binding SelectStatusPagoCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPagoSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FinTitle}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsStatusPagoSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{StaticResource FinSubtitle}" />
                            <Setter Property="BorderColor" Value="{StaticResource FinFieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <Label Text="Carregando lançamentos…"
                   IsVisible="{Binding ShowInitialLoading}"
                   TextColor="{StaticResource FinSubtitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Text="Nenhum lançamento encontrado."
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{StaticResource FinSubtitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadMovimentacoesCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="MovimentacoesCollectionView" ItemsSource="{Binding Movimentacoes}" Margin="20,0,20,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MovimentacaoFinanceiraRowViewModel">
                            <Border BackgroundColor="{StaticResource FinCardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,8,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.EditMovimentacaoCommand, Source={x:Reference MovimentacoesCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="Ellipse"
                                            Stroke="Transparent"
                                            Padding="0">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource FinEntradaBg}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEntrada}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource FinSaidaBg}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding IconGlyph}"
                                               FontFamily="FontAwesomeSolid"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource FinEntradaFg}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource FinSaidaFg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Descricao}"
                                               TextColor="{StaticResource FinTitle}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding CategoriaNome}"
                                               TextColor="{StaticResource FinSubtitle}"
                                               FontSize="12" />
                                        <Label Text="{Binding DataVencimentoFormatada}"
                                               TextColor="{StaticResource FinSubtitle}"
                                               FontSize="12" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding ValorFormatado}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource FinEntradaFg}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEntrada}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource FinSaidaFg}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,3" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPago}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource FinStatusPagoBg}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPago}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource FinStatusPendenteBg}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPago}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource FinStatusPagoFg}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPago}" Value="False">
                                                        <Setter Property="TextColor" Value="{StaticResource FinStatusPendenteFg}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <Label Text="{Binding ParcelaLabel}"
                                               IsVisible="{Binding HasParcelaLabel}"
                                               TextColor="{StaticResource FinSubtitle}"
                                               FontSize="11"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <Border HeightRequest="56"
                    WidthRequest="56"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    BackgroundColor="{StaticResource FinPrimary}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddMovimentacaoCommand}" />
                </Border.GestureRecognizers>

                <Label Text="+"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="30"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-4,0,0" />
            </Border>

        </Grid>

    </Grid>

</ContentPage>
