<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:models="clr-namespace:checkfrota_front.Models"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.MovimentacaoFinanceiraFormPage"
             x:DataType="viewmodels:MovimentacaoFinanceiraFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Lançamento">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="{Binding PageTitle}"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Danger}"
                       FontSize="13" />

                <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="10,6"
                        HorizontalOptions="Start" IsVisible="{Binding IsEditing}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPendente}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource WarningBg}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPendente}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding StatusLabel}" FontAttributes="Bold" FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPendente}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPendente}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding ParcelaLabel}" IsVisible="{Binding HasParcelaLabel}"
                               TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tipo" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Entrada"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectEntradaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="entrada">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="saida">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="Saída"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectSaidaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="saida">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="entrada">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Descrição" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Descricao}"
                               Placeholder="Ex: Recebimento de frete"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Valor" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Grid.Column="0"
                                   Text="R$"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Valor}"
                                   Placeholder="0,00"
                                   Keyboard="Default"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Data de vencimento" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <DatePicker Date="{Binding DataVencimento}"
                                    Format="dd/MM/yyyy"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoria" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Categorias}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedCategoria}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Forma de pagamento" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding FormasPagamento}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedFormaPagamento}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCreating}">
                    <Label Grid.Column="0" Text="{Binding MarcarComoPagoLabel}"
                           TextColor="{DynamicResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding MarcarComoPago}" />
                </Grid>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowDataPagamentoPicker}">
                    <Label Text="Data do pagamento" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <DatePicker Date="{Binding DataPagamento}"
                                    Format="dd/MM/yyyy"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Comprovante (opcional)" TextColor="{DynamicResource TextSecondary}" FontSize="12" />

                    <Border IsVisible="{Binding HasNoComprovante}"
                            BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeDashArray="4,3"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AnexarComprovanteCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="{x:Static helpers:IconFont.Anexo}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="{DynamicResource Accent}"
                                       VerticalOptions="Center" />
                                <Label Text="Anexar comprovante"
                                       TextColor="{DynamicResource Accent}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Foto (JPG, PNG) ou PDF de até 10 MB"
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding HasComprovante}"
                            BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{x:Static helpers:IconFont.Anexo}"
                                   FontFamily="FontAwesomeSolid"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ComprovanteNome}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   LineBreakMode="MiddleTruncation"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="Ver"
                                    Command="{Binding AbrirComprovanteCommand}"
                                    IsVisible="{Binding CanAbrirComprovante}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Accent}"
                                    FontAttributes="Bold"
                                    Padding="8,0"
                                    HeightRequest="36" />
                            <Button Grid.Column="3"
                                    Text="Remover"
                                    Command="{Binding RemoverComprovanteCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Danger}"
                                    FontAttributes="Bold"
                                    Padding="8,0"
                                    HeightRequest="36" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Salvar"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

                <Button Text="Marcar como pago"
                        Command="{Binding MarcarComoPagoCommand}"
                        IsVisible="{Binding CanMarcarComoPago}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource SuccessSolid}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button Text="Excluir lançamento"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Danger}"
                        FontAttributes="Bold"
                        BorderColor="{DynamicResource Danger}"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
