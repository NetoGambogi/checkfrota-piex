<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:models="clr-namespace:checkfrota_front.Models"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.MovimentacaoFinanceiraFormPage"
             x:DataType="viewmodels:MovimentacaoFinanceiraFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="White"
             Title="Lançamento">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="FormTitle">#1F2430</Color>
            <Color x:Key="FormSubtitle">#6B7280</Color>
            <Color x:Key="FormFieldBg">#F8F9FB</Color>
            <Color x:Key="FormFieldBorder">#E2E4E9</Color>
            <Color x:Key="FormPrimary">#3D4FE0</Color>
            <Color x:Key="FormDanger">#DC2626</Color>
            <Color x:Key="FormStatusPagoBg">#DCFCE7</Color>
            <Color x:Key="FormStatusPagoFg">#16A34A</Color>
            <Color x:Key="FormStatusPendenteBg">#FEF3C7</Color>
            <Color x:Key="FormStatusPendenteFg">#B45309</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="{Binding PageTitle}"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource FormDanger}"
                       FontSize="13" />

                <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="10,6"
                        HorizontalOptions="Start" IsVisible="{Binding IsEditing}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPendente}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FormStatusPendenteBg}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPendente}" Value="False">
                            <Setter Property="BackgroundColor" Value="{StaticResource FormStatusPagoBg}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding StatusLabel}" FontAttributes="Bold" FontSize="12">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPendente}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource FormStatusPendenteFg}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPendente}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource FormStatusPagoFg}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding ParcelaLabel}" IsVisible="{Binding HasParcelaLabel}"
                               TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tipo" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Entrada"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectEntradaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="entrada">
                                    <Setter Property="BackgroundColor" Value="{StaticResource FormPrimary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="saida">
                                    <Setter Property="BackgroundColor" Value="White" />
                                    <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
                                    <Setter Property="BorderColor" Value="{StaticResource FormFieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="Saída"
                                CornerRadius="10"
                                HeightRequest="46"
                                Command="{Binding SelectSaidaCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="saida">
                                    <Setter Property="BackgroundColor" Value="{StaticResource FormPrimary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding Tipo}" Value="entrada">
                                    <Setter Property="BackgroundColor" Value="White" />
                                    <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
                                    <Setter Property="BorderColor" Value="{StaticResource FormFieldBorder}" />
                                    <Setter Property="BorderWidth" Value="1" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Descrição" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Descricao}"
                               Placeholder="Ex: Recebimento de frete"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Valor (R$)" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Valor}"
                               Placeholder="0,00"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Data de vencimento" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <DatePicker Date="{Binding DataVencimento}"
                                    TextColor="{StaticResource FormTitle}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoria" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Categorias}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedCategoria}"
                                TextColor="{StaticResource FormTitle}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Forma de pagamento" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding FormasPagamento}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedFormaPagamento}"
                                TextColor="{StaticResource FormTitle}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCreating}">
                    <Label Grid.Column="0" Text="{Binding MarcarComoPagoLabel}"
                           TextColor="{StaticResource FormTitle}"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding MarcarComoPago}" />
                </Grid>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding MarcarComoPago}">
                    <Label Text="Data do pagamento" TextColor="{StaticResource FormSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource FormFieldBg}"
                            Stroke="{StaticResource FormFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <DatePicker Date="{Binding DataPagamento}"
                                    TextColor="{StaticResource FormTitle}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Salvar"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource FormPrimary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

                <Button Text="Marcar como pago"
                        Command="{Binding MarcarComoPagoCommand}"
                        IsVisible="{Binding CanMarcarComoPago}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource FormStatusPagoFg}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button Text="Excluir lançamento"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource FormDanger}"
                        FontAttributes="Bold"
                        BorderColor="{StaticResource FormDanger}"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
