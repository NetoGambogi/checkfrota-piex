<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             x:Class="checkfrota_front.Views.HodometroPage"
             x:DataType="viewmodels:HodometroViewModel"
             Title="Registrar Hodômetro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="VEÍCULO" FontSize="11" TextColor="Gray" />
            <Label Text="{Binding Veiculo}" FontSize="16" FontAttributes="Bold" />

            <Label Text="QUILOMETRAGEM ANTERIOR" FontSize="11" TextColor="Gray" />
            <Label Text="{Binding KmAnterior, StringFormat='{0} km'}" FontSize="16" />

            <Label Text="QUILOMETRAGEM ATUAL *" FontSize="11" TextColor="Gray" />
            <Entry Text="{Binding KmAtual}" Keyboard="Numeric" Placeholder="0" FontSize="20" />

            <Label Text="OBSERVAÇÃO (OPCIONAL)" FontSize="11" TextColor="Gray" />
            <Editor Text="{Binding Observacao}" HeightRequest="90" />

            <Label Text="{Binding Erro}" TextColor="Red" />

            <Border Padding="12" StrokeShape="RoundRectangle 10">
                <Label Text="O registro é salvo no aparelho e enviado automaticamente quando houver conexão."
                       FontSize="12" />
            </Border>

            <Button Text="Salvar registro" Command="{Binding SalvarCommand}" HeightRequest="52" />
            <Button Text="Cancelar" Command="{Binding CancelarCommand}" HeightRequest="48" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>