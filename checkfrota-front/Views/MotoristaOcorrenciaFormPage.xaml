<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.MotoristaOcorrenciaFormPage"
             x:DataType="viewmodels:MotoristaOcorrenciaFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Ocorrência">

    <ContentPage.Resources>
        <Style x:Key="GravidadeButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Registrar ocorrência"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                WidthRequest="46"
                                HeightRequest="46"
                                StrokeShape="Ellipse"
                                Stroke="Transparent"
                                Padding="0"
                                BackgroundColor="{DynamicResource DangerSoftBg}">
                            <Label Text="{x:Static helpers:IconFont.Alerta}"
                                   FontFamily="FontAwesomeSolid"
                                   TextColor="{DynamicResource Danger}"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ViagemLabel}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="A gestão da frota é avisada assim que você registrar."
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Danger}"
                       FontSize="13" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Tipo de problema" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Tipos}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedTipo}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Gravidade" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Baixa" Style="{StaticResource GravidadeButton}"
                                Command="{Binding SelecionarGravidadeCommand}" CommandParameter="baixa">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGravidadeBaixa}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoftBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Média" Style="{StaticResource GravidadeButton}"
                                Command="{Binding SelecionarGravidadeCommand}" CommandParameter="media">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGravidadeMedia}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource WarningBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource Warning}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="Alta" Style="{StaticResource GravidadeButton}"
                                Command="{Binding SelecionarGravidadeCommand}" CommandParameter="alta">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsGravidadeAlta}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource DangerSoftBg}" />
                                    <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource Danger}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Label Text="{Binding GravidadeAjuda}"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Km no hodômetro" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Km}"
                               Placeholder="Onde o problema aconteceu"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding KmFaixaLabel}"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="O que aconteceu" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="8,4">
                        <Editor Text="{Binding Descricao}"
                                Placeholder="Ex: luz do óleo acendeu e o motor perdeu força na subida."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="100"
                                MaxLength="1000"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Foto (opcional)" TextColor="{DynamicResource TextSecondary}" FontSize="12" />

                    <Border IsVisible="{Binding HasNoFoto}"
                            BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeDashArray="4,3"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AnexarFotoCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="{x:Static helpers:IconFont.Anexo}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       TextColor="{DynamicResource Accent}"
                                       VerticalOptions="Center" />
                                <Label Text="Fotografar o problema"
                                       TextColor="{DynamicResource Accent}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Ajuda a gestão a entender a situação"
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasFoto}">
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="200"
                                Padding="0">
                            <Image Source="{Binding FotoCaminho}" Aspect="AspectFill" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Trocar foto"
                                    Command="{Binding AnexarFotoCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Accent}"
                                    FontAttributes="Bold"
                                    HeightRequest="40" />
                            <Button Grid.Column="1"
                                    Text="Remover"
                                    Command="{Binding RemoverFotoCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Danger}"
                                    FontAttributes="Bold"
                                    HeightRequest="40" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Button Text="Registrar ocorrência"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
