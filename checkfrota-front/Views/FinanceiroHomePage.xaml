<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             x:Class="checkfrota_front.Views.FinanceiroHomePage"
             x:DataType="viewmodels:FinanceiroHomeViewModel"
             Title="Financeiro">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="{Binding UserName, StringFormat='Bem-vindo, {0}'}"
               FontSize="24"
               HorizontalOptions="Center" />

        <Button Text="Sair"
                Command="{Binding LogoutCommand}"
                HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>
