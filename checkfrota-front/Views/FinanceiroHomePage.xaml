<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.FinanceiroHomePage"
             x:DataType="viewmodels:FinanceiroHomeViewModel"
             Shell.NavBarIsVisible="False"
             Title="Financeiro">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Financeiro"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="25" VerticalOptions="Center">

            <Label Text="{Binding UserName, StringFormat='Bem-vindo, {0}'}"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <Button Text="Sair"
                    Command="{Binding LogoutCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
