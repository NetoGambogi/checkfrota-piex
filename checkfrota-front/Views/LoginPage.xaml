<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             x:Class="checkfrota_front.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Login">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="checkfrota"
               FontSize="32"
               HorizontalOptions="Center" />

        <Button Text="Entrar com Google"
                Command="{Binding LoginCommand}"
                HorizontalOptions="Fill" />

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center" />

        <Label Text="{Binding ErrorMessage}"
               TextColor="Red"
               HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
