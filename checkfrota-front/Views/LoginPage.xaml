<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             x:Class="checkfrota_front.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Login">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LoginNavyDeep">#03060F</Color>
            <Color x:Key="LoginMutedText">#93A7D1</Color>
            <Color x:Key="LoginDivider">#2A3A63</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource LoginNavyDeep}">

        <Image Source="trucks_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Padding="32,64,32,40" Spacing="0">

                <Image Source="trucks_header.png"
                       HeightRequest="70"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8" />

                <Label Text="CHECKFROTA"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="24"
                       CharacterSpacing="2"
                       HorizontalOptions="Center"
                       Margin="0,4,0,4" />

                <Label Text="Gestão de Frotas e Logística"
                       TextColor="{StaticResource LoginMutedText}"
                       FontSize="15"
                       HorizontalOptions="Center"
                       Margin="0,0,0,40" />

                <Button Text="Entrar com o Google"
                        Command="{Binding LoginCommand}"
                        ImageSource="google_icon.svg"
                        BackgroundColor="White"
                        TextColor="#1F1F1F"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="28"
                        HeightRequest="56"
                        HorizontalOptions="Fill" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="White"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FF8A80"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0" />

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,24,0,0">
                    <BoxView Grid.Column="0" HeightRequest="1" Color="{StaticResource LoginDivider}" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource LoginDivider}" VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
