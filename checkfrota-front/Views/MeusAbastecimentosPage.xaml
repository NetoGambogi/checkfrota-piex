<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.MeusAbastecimentosPage"
             x:DataType="viewmodels:MeusAbastecimentosViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Meus abastecimentos">

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Abastecimentos"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,4" Spacing="8" BackgroundColor="{DynamicResource PageBg}">

            <Label Text="Meus abastecimentos"
                   TextColor="{DynamicResource TextPrimary}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <Label Text="Carregando abastecimentos…"
                   IsVisible="{Binding ShowInitialLoading}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Text="Você ainda não registrou abastecimentos."
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadAbastecimentosCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="AbastecimentosCollectionView" ItemsSource="{Binding Abastecimentos}" Margin="20,0,20,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AbastecimentoRowViewModel">
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,8,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.AbrirComprovanteCommand, Source={x:Reference AbastecimentosCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="Ellipse"
                                            Stroke="Transparent"
                                            Padding="0"
                                            BackgroundColor="{DynamicResource AccentSoftBg}">
                                        <Label Text="{x:Static helpers:IconFont.CategoriaCombustivel}"
                                               FontFamily="FontAwesomeSolid"
                                               TextColor="{DynamicResource Accent}"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Titulo}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{Binding DetalheLabel}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding KmLabel}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="12" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding ValorFormatado}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               HorizontalOptions="End" />

                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,3" HorizontalOptions="End"
                                                BackgroundColor="{DynamicResource WarningBg}"
                                                IsVisible="{Binding IsParcial}">
                                            <Label Text="Parcial" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Warning}" />
                                        </Border>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <Border HeightRequest="56"
                    WidthRequest="56"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    BackgroundColor="{DynamicResource Accent}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RegistrarAbastecimentoCommand}" />
                </Border.GestureRecognizers>

                <Label Text="+"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="30"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-4,0,0" />
            </Border>

        </Grid>

    </Grid>

</ContentPage>
