<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.UserManagementPage"
             x:DataType="viewmodels:UserManagementViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A1330"
             Title="Usuários">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="MgmtHeaderBg">#0A1330</Color>
            <Color x:Key="MgmtTitle">#1F2430</Color>
            <Color x:Key="MgmtSubtitle">#6B7280</Color>
            <Color x:Key="MgmtCardBg">#F1F2F4</Color>
            <Color x:Key="MgmtDanger">#DC2626</Color>
            <Color x:Key="MgmtSuccess">#16A34A</Color>
            <Color x:Key="MgmtFieldBg">#F8F9FB</Color>
            <Color x:Key="MgmtFieldBorder">#E2E4E9</Color>
            <Color x:Key="MgmtDivider">#E5E7EB</Color>
            <Color x:Key="MgmtActiveBg">#DCFCE7</Color>
            <Color x:Key="MgmtActiveText">#15803D</Color>
            <Color x:Key="MgmtInactiveBg">#FEE2E2</Color>
            <Color x:Key="MgmtInactiveText">#B91C1C</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="White">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Usuários"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <!-- Busca e filtro -->
        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,12" Spacing="10" BackgroundColor="White">

            <Label Text="Gerenciar usuários"
                   TextColor="{StaticResource MgmtTitle}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource MgmtDanger}"
                   FontSize="13" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Nome" TextColor="{StaticResource MgmtSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource MgmtFieldBg}"
                            Stroke="{StaticResource MgmtFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="44"
                            Padding="4,0"
                            VerticalOptions="Center">
                        <SearchBar Placeholder="Pesquisar"
                                   Text="{Binding SearchText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Role" TextColor="{StaticResource MgmtSubtitle}" FontSize="12" />
                    <Border BackgroundColor="{StaticResource MgmtFieldBg}"
                            Stroke="{StaticResource MgmtFieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="44"
                            Padding="12,0"
                            VerticalOptions="Center">
                        <Picker ItemsSource="{Binding RoleFilterOptions}"
                                SelectedItem="{Binding SelectedRole}"
                                TextColor="{StaticResource MgmtTitle}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Status" TextColor="{StaticResource MgmtSubtitle}" FontSize="12" />
                <Border BackgroundColor="{StaticResource MgmtFieldBg}"
                        Stroke="{StaticResource MgmtFieldBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="44"
                        Padding="12,0"
                        VerticalOptions="Center">
                    <Picker ItemsSource="{Binding StatusFilterOptions}"
                            SelectedItem="{Binding SelectedStatus}"
                            TextColor="{StaticResource MgmtTitle}"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- Lista -->
        <Grid Grid.Row="2">

            <Label Text="Carregando usuários…"
                   IsVisible="{Binding ShowInitialLoading}"
                   TextColor="{StaticResource MgmtSubtitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Text="Nenhum usuário encontrado."
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{StaticResource MgmtSubtitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadUsersCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="UsuariosCollectionView"
                                ItemsSource="{Binding Users}"
                                Margin="20,0,20,16">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:UserRowViewModel">
                            <Border BackgroundColor="{StaticResource MgmtCardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="18,16"
                                    Margin="0,14,0,0">

                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="14" Offset="0,6" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border Grid.Column="0"
                                                WidthRequest="46"
                                                HeightRequest="46"
                                                StrokeShape="Ellipse"
                                                Stroke="Transparent"
                                                Padding="0">
                                            <Grid>
                                                <BoxView Color="{StaticResource MgmtHeaderBg}" />
                                                <Label Text="{Binding Initials}"
                                                       IsVisible="{Binding NoAvatar}"
                                                       TextColor="White"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Image Source="{Binding Avatar}"
                                                       Aspect="AspectFill"
                                                       IsVisible="{Binding HasAvatar}" />
                                            </Grid>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       TextColor="{StaticResource MgmtTitle}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       LineBreakMode="TailTruncation" />
                                                <ActivityIndicator Grid.Column="1"
                                                                    IsVisible="{Binding IsBusy}"
                                                                    IsRunning="{Binding IsBusy}"
                                                                    HeightRequest="18"
                                                                    WidthRequest="18" />
                                            </Grid>
                                            <Label Text="{Binding Email}"
                                                   TextColor="{StaticResource MgmtSubtitle}"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Grid Grid.Column="2" VerticalOptions="Center">
                                            <Border IsVisible="{Binding IsActive}"
                                                    BackgroundColor="{StaticResource MgmtActiveBg}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 20"
                                                    Padding="10,4">
                                                <Label Text="Ativo" TextColor="{StaticResource MgmtActiveText}" FontAttributes="Bold" FontSize="11" />
                                            </Border>
                                            <Border IsVisible="{Binding IsInactive}"
                                                    BackgroundColor="{StaticResource MgmtInactiveBg}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 20"
                                                    Padding="10,4">
                                                <Label Text="Inativo" TextColor="{StaticResource MgmtInactiveText}" FontAttributes="Bold" FontSize="11" />
                                            </Border>
                                        </Grid>

                                    </Grid>

                                    <Label Text="{Binding CreatedAtText, StringFormat='Cadastrado em {0}'}"
                                           TextColor="{StaticResource MgmtSubtitle}"
                                           FontSize="12" />

                                    <BoxView HeightRequest="1" Color="{StaticResource MgmtDivider}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                        <Picker Grid.Column="0"
                                                Title="Role"
                                                IsEnabled="{Binding IsActive}"
                                                SelectedItem="{Binding Role}"
                                                SelectedIndexChanged="OnRolePickerChanged">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>admin</x:String>
                                                    <x:String>motorista</x:String>
                                                    <x:String>frota</x:String>
                                                    <x:String>financeiro</x:String>
                                                    <x:String>pendente</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>

                                        <Button Grid.Column="1"
                                                Text="Inativar"
                                                IsVisible="{Binding IsActive}"
                                                BackgroundColor="{StaticResource MgmtDanger}"
                                                TextColor="White"
                                                FontSize="12"
                                                CornerRadius="8"
                                                Padding="14,0"
                                                Command="{Binding Path=BindingContext.DeactivateCommand, Source={x:Reference UsuariosCollectionView}}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1"
                                                Text="Reativar"
                                                IsVisible="{Binding IsInactive}"
                                                BackgroundColor="{StaticResource MgmtSuccess}"
                                                TextColor="White"
                                                FontSize="12"
                                                CornerRadius="8"
                                                Padding="14,0"
                                                Command="{Binding Path=BindingContext.RestoreCommand, Source={x:Reference UsuariosCollectionView}}"
                                                CommandParameter="{Binding .}" />

                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
