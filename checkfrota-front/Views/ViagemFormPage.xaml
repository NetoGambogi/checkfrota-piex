<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.ViagemFormPage"
             x:DataType="viewmodels:ViagemFormViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Viagem">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="{Binding PageTitle}"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Danger}"
                       FontSize="13" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Rota" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Rotas}"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedItem="{Binding SelectedRota}"
                                Title="Selecione a rota"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding KmEstimadoLabel}"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Veículo" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Picker ItemsSource="{Binding Veiculos}"
                                ItemDisplayBinding="{Binding Rotulo}"
                                SelectedItem="{Binding SelectedVeiculo}"
                                Title="Selecione o veículo"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Cliente (opcional)" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Cliente}"
                               Placeholder="Quem contratou o frete"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Data de saída" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <DatePicker Date="{Binding DataSaida}"
                                        Format="dd/MM/yyyy"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Km na saída" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Text="{Binding KmSaida}"
                                   Placeholder="Opcional"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Viagem concluída"
                           TextColor="{DynamicResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding Concluida}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Concluida}">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Data de chegada" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <DatePicker Date="{Binding DataChegada}"
                                        Format="dd/MM/yyyy"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Km na chegada" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Text="{Binding KmChegada}"
                                   Placeholder="Opcional"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Observações (opcional)" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0">
                        <Entry Text="{Binding Observacoes}"
                               Placeholder="Ex: carga, nota fiscal, motorista"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="Frete"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,6,0,0" />

                <Label Text="{Binding StatusReceitaLabel}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="13" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Lançar receita do frete no financeiro"
                           TextColor="{DynamicResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding LancarFrete}" />
                </Grid>

                <VerticalStackLayout Spacing="18" IsVisible="{Binding LancarFrete}">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Valor do frete (R$)" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="R$"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ValorFrete}"
                                       Placeholder="0,00"
                                       Keyboard="Default"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <shared:LancamentoFinanceiroFields BindingContext="{Binding Financeiro}" />

                </VerticalStackLayout>

                <Button Text="Salvar viagem"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

                <Button Text="Excluir viagem"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditing}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Danger}"
                        FontAttributes="Bold"
                        BorderColor="{DynamicResource Danger}"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>

        <shared:LoadingOverlay Grid.RowSpan="2"
                               IsBusy="{Binding IsBusy}"
                               Message="{Binding BusyMessage}" />

    </Grid>

</ContentPage>
