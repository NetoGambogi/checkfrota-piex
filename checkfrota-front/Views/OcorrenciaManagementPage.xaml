<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             x:Class="checkfrota_front.Views.OcorrenciaManagementPage"
             x:DataType="viewmodels:OcorrenciaManagementViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Ocorrências">

    <ContentPage.Resources>
        <Style x:Key="AbaButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Frota"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,4" Spacing="12" BackgroundColor="{DynamicResource PageBg}">

            <Label Text="Ocorrências"
                   TextColor="{DynamicResource TextPrimary}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="{Binding AbertasLabel}" Style="{StaticResource AbaButton}"
                        Command="{Binding SelecionarAbaCommand}" CommandParameter="aberta">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaAbertas}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaAbertas}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Resolvidas" Style="{StaticResource AbaButton}"
                        Command="{Binding SelecionarAbaCommand}" CommandParameter="resolvida">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaResolvidas}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaResolvidas}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <shared:LoadingState Message="Carregando ocorrências…"
                                 IsBusy="{Binding ShowInitialLoading}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />

            <Label Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadOcorrenciasCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="OcorrenciasCollectionView" ItemsSource="{Binding Ocorrencias}" Margin="20,0,20,16">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:OcorrenciaRowViewModel">
                            <shared:OcorrenciaCard>
                                <shared:OcorrenciaCard.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.AbrirOcorrenciaCommand, Source={x:Reference OcorrenciasCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </shared:OcorrenciaCard.GestureRecognizers>
                            </shared:OcorrenciaCard>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
