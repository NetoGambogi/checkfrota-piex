<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:models="clr-namespace:checkfrota_front.Models"
             x:Class="checkfrota_front.Views.MinhasViagensPage"
             x:DataType="viewmodels:MinhasViagensViewModel"
             Title="Minhas Viagens">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Em andamento"
                    Command="{Binding SelecionarAbaCommand}" CommandParameter="andamento" />
            <Button Grid.Column="1" Text="Concluídas"
                    Command="{Binding SelecionarAbaCommand}" CommandParameter="concluidas" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Viagens}">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma viagem encontrada." HorizontalOptions="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ViagemItem">
                    <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#374151}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Codigo}" FontAttributes="Bold" />
                                <Border Grid.Column="1" BackgroundColor="{Binding StatusCor}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,3">
                                    <Label Text="{Binding Status}" TextColor="White" FontSize="11" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Rota}" FontSize="16" />
                            <Label Text="{Binding Veiculo}" TextColor="Gray" FontSize="12" />
                            <Label Text="{Binding Data}" TextColor="Gray" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>