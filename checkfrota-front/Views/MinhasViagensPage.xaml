<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.MinhasViagensPage"
             x:DataType="viewmodels:MinhasViagensViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Minhas Viagens">

    <ContentPage.Resources>
        <Style x:Key="AbaButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Viagens"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,4" Spacing="12" BackgroundColor="{DynamicResource PageBg}">

            <Label Text="Minhas viagens"
                   TextColor="{DynamicResource TextPrimary}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Em andamento" Style="{StaticResource AbaButton}"
                        Command="{Binding SelecionarAbaCommand}" CommandParameter="em_andamento">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaEmAndamento}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaEmAndamento}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Concluídas" Style="{StaticResource AbaButton}"
                        Command="{Binding SelecionarAbaCommand}" CommandParameter="concluida">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaConcluidas}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAbaConcluidas}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <shared:LoadingState Message="Carregando viagens…"
                                 IsBusy="{Binding ShowInitialLoading}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />

            <Label Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadViagensCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="ViagensCollectionView"
                                ItemsSource="{Binding Viagens}"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                                Margin="20,0,20,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ViagemRowViewModel">
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,8,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.AbrirViagemCommand, Source={x:Reference ViagensCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="Ellipse"
                                            Stroke="Transparent"
                                            Padding="0"
                                            BackgroundColor="{DynamicResource AccentSoftBg}">
                                        <Label Text="{x:Static helpers:IconFont.Viagem}"
                                               FontFamily="FontAwesomeSolid"
                                               TextColor="{DynamicResource Accent}"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding RotaNome}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Subtitulo}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PeriodoLabel}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="12" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding KmLabel}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               HorizontalOptions="End" />

                                        <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,3" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding EmAndamento}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource WarningBg}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding EmAndamento}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EmAndamento}" Value="True">
                                                        <Setter Property="Text" Value="Em andamento" />
                                                        <Setter Property="TextColor" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EmAndamento}" Value="False">
                                                        <Setter Property="Text" Value="Concluída" />
                                                        <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <shared:LoadingState Message="Carregando mais…"
                                             IsBusy="{Binding IsLoadingMore}"
                                             HorizontalOptions="Center"
                                             Margin="0,12" />
                    </CollectionView.Footer>

                </CollectionView>
            </RefreshView>

            <Border HeightRequest="56"
                    WidthRequest="56"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    BackgroundColor="{DynamicResource Accent}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IniciarViagemCommand}" />
                </Border.GestureRecognizers>

                <Label Text="+"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="30"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,-4,0,0" />
            </Border>

        </Grid>

    </Grid>

</ContentPage>
