<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="checkfrota_front.Views.Shared.GravidadeBadge">

    <!-- Selo da gravidade de uma ocorrência: alta (vermelho), média (amarelo) ou baixa (azul). -->
    <Border x:Name="Selo"
            StrokeShape="RoundRectangle 8"
            Stroke="Transparent"
            Padding="8,3"
            HorizontalOptions="Start">
        <Label x:Name="Texto" FontSize="11" FontAttributes="Bold" />
    </Border>

</ContentView>
