<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.Shared.FiltroPeriodoView"
             x:DataType="viewmodels:FiltroPeriodo">

    <ContentView.Resources>
        <Style x:Key="ChipAtalho" TargetType="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="10">

        <!-- Resumo do período; toque para abrir os atalhos e as datas -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AlternarExpandidoCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Column="0"
                   Text="{x:Static helpers:IconFont.Pendente}"
                   FontFamily="FontAwesomeSolid"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="12"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding Resumo}"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="12"
                   VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="{x:Static helpers:IconFont.ChevronDireita}"
                   FontFamily="FontAwesomeSolid"
                   TextColor="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Rotation="{Binding ChevronRotation}"
                   VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExpandido}">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Este mês" Style="{StaticResource ChipAtalho}"
                        Command="{Binding SelecionarAtalhoCommand}" CommandParameter="mes">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsEsteMes}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsEsteMes}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="3 meses" Style="{StaticResource ChipAtalho}"
                        Command="{Binding SelecionarAtalhoCommand}" CommandParameter="3meses">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTresMeses}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTresMeses}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="12 meses" Style="{StaticResource ChipAtalho}"
                        Command="{Binding SelecionarAtalhoCommand}" CommandParameter="12meses">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDozeMeses}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsDozeMeses}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource FieldBorder}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="De" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="42"
                            Padding="10,0">
                        <DatePicker Date="{Binding DataInicio}"
                                    Format="dd/MM/yyyy"
                                    FontSize="13"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Até" TextColor="{DynamicResource TextSecondary}" FontSize="11" />
                    <Border BackgroundColor="{DynamicResource FieldBg}"
                            Stroke="{DynamicResource FieldBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="42"
                            Padding="10,0">
                        <DatePicker Date="{Binding DataFim}"
                                    Format="dd/MM/yyyy"
                                    FontSize="13"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>
