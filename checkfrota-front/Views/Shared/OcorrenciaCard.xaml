<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.Shared.OcorrenciaCard"
             x:DataType="viewmodels:OcorrenciaRowViewModel">

    <!-- Card de ocorrência usado nas listas do motorista e da gestão da frota. -->
    <Border BackgroundColor="{DynamicResource CardBg}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 16"
            Padding="16"
            Margin="0,8,0,0">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

            <Border Grid.Column="0"
                    WidthRequest="46"
                    HeightRequest="46"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    VerticalOptions="Start"
                    BackgroundColor="{DynamicResource AccentSoftBg}">
                <Label Text="{x:Static helpers:IconFont.Alerta}"
                       FontFamily="FontAwesomeSolid"
                       TextColor="{DynamicResource Accent}"
                       FontSize="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{Binding Titulo}"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold"
                       FontSize="16"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding Subtitulo}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="13"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding Descricao}"
                       TextColor="{DynamicResource TextPrimary}"
                       FontSize="13"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />

                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                    <shared:GravidadeBadge Gravidade="{Binding Original.Gravidade}" />

                    <Border StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,3">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsResolvida}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsResolvida}" Value="False">
                                <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
                                <Setter Property="Stroke" Value="{DynamicResource FieldBorder}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsResolvida}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsResolvida}" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Label Text="{x:Static helpers:IconFont.Anexo}"
                           IsVisible="{Binding HasFoto}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="{Binding DetalheLabel}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="12" />
            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
