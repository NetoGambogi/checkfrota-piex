<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             xmlns:services="clr-namespace:checkfrota_front.Services"
             x:Class="checkfrota_front.Views.Shared.AdminTopBar"
             x:Name="Root">

    <!-- Botões com área de toque de 48x48 (mínimo recomendado no Android), maior que o ícone:
         o padding menor compensa, mantendo os ícones onde estavam. -->
    <Grid BackgroundColor="{DynamicResource HeaderBg}" HeightRequest="64" Padding="6,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="0">

        <Grid Grid.Column="0"
              WidthRequest="52"
              HeightRequest="56"
              BackgroundColor="Transparent"
              VerticalOptions="Center"
              IsVisible="{Binding ShowBackButton, Source={x:Reference Root}}">
            <Label Text="{x:Static helpers:IconFont.Back}"
                   FontFamily="FontAwesomeSolid"
                   FontSize="20"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Label x:Name="Titulo"
               Grid.Column="1"
               Margin="14,0,8,0"
               Text="{Binding Title, Source={x:Reference Root}}"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

        <!-- Sino: BindingContext é o NotificacaoService (definido no code-behind) -->
        <Grid x:Name="Sino"
              x:DataType="services:NotificacaoService"
              Grid.Column="2"
              WidthRequest="48"
              HeightRequest="56"
              BackgroundColor="Transparent"
              VerticalOptions="Center">
            <Label Text="{x:Static helpers:IconFont.Notificacao}"
                   FontFamily="FontAwesomeSolid"
                   FontSize="20"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <Border BackgroundColor="{DynamicResource DangerSolid}"
                    Stroke="{DynamicResource HeaderBg}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 9"
                    MinimumWidthRequest="18"
                    HeightRequest="18"
                    Padding="4,0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,10,3,0"
                    IsVisible="{Binding PossuiNaoLidas}">
                <Label Text="{Binding NaoLidasTexto}"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="10"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSinoTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- A área de toque é o Grid inteiro (56x56), não só a foto de 36px. -->
        <Grid Grid.Column="3"
              WidthRequest="56"
              HeightRequest="56"
              BackgroundColor="Transparent"
              VerticalOptions="Center">
            <Border WidthRequest="38"
                    HeightRequest="38"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    InputTransparent="True">
                <Grid>
                    <Image Source="person_icon.svg" Aspect="AspectFill" />
                    <Image Source="{Binding AvatarUrl, Source={x:Reference Root}}"
                           Aspect="AspectFill"
                           IsVisible="{Binding HasAvatar, Source={x:Reference Root}}" />
                </Grid>
            </Border>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAvatarTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>

</ContentView>
