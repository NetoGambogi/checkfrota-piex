<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="checkfrota_front.Views.Shared.AdminTopBar"
             x:Name="Root">

    <Grid BackgroundColor="#0A1330" HeightRequest="64" Padding="20,0" ColumnDefinitions="*,Auto">

        <Label Grid.Column="0"
               Text="{Binding Title, Source={x:Reference Root}}"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

        <Border Grid.Column="1"
                WidthRequest="36"
                HeightRequest="36"
                StrokeShape="Ellipse"
                Stroke="Transparent"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="Center">
            <Grid>
                <Image Source="person_icon.svg" Aspect="AspectFill" />
                <Image Source="{Binding AvatarUrl, Source={x:Reference Root}}"
                       Aspect="AspectFill"
                       IsVisible="{Binding HasAvatar, Source={x:Reference Root}}" />
            </Grid>
        </Border>
    </Grid>

</ContentView>
