<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.ConcluirViagemPage"
             x:DataType="viewmodels:ConcluirViagemViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="Modal"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Concluir viagem">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Concluir viagem"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">

                <Border BackgroundColor="{DynamicResource CardBg}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                WidthRequest="46"
                                HeightRequest="46"
                                StrokeShape="Ellipse"
                                Stroke="Transparent"
                                Padding="0"
                                BackgroundColor="{DynamicResource AccentSoftBg}">
                            <Label Text="{x:Static helpers:IconFont.Viagem}"
                                   FontFamily="FontAwesomeSolid"
                                   TextColor="{DynamicResource Accent}"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding RotaNome}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Trajeto}"
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontSize="13" />
                            <Label Text="{Binding SaidaLabel}"
                                   TextColor="{DynamicResource TextSecondary}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Danger}"
                       FontSize="13" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Data de chegada" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <DatePicker Date="{Binding DataChegada}"
                                        MinimumDate="{Binding DataSaida}"
                                        Format="dd/MM/yyyy"
                                        TextColor="{DynamicResource TextPrimary}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Km na chegada" TextColor="{DynamicResource TextSecondary}" FontSize="12" />
                        <Border BackgroundColor="{DynamicResource FieldBg}"
                                Stroke="{DynamicResource FieldBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Padding="12,0">
                            <Entry Text="{Binding KmChegada}"
                                   Placeholder="Hodômetro"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Label Text="{Binding KmPercorridoLabel}"
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="12"
                       Margin="0,-10,0,0" />

                <Label Text="Depois de concluída, a viagem só pode ser corrigida pela gestão da frota."
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="13" />

                <Button Text="Concluir viagem"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{DynamicResource Accent}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <shared:LoadingOverlay Grid.RowSpan="2"
                               IsBusy="{Binding IsBusy}"
                               Message="{Binding BusyMessage}" />

    </Grid>

</ContentPage>
