<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.NotificacoesPage"
             x:DataType="viewmodels:NotificacoesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Notificações">

    <Grid RowDefinitions="Auto,Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Notificações"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}"
                             ShowBackButton="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,4" Spacing="8" BackgroundColor="{DynamicResource PageBg}">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       Text="Notificações"
                       TextColor="{DynamicResource TextPrimary}"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="6"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Central.PossuiNaoLidas}">
                    <Label Text="{x:Static helpers:IconFont.MarcarLidas}"
                           FontFamily="FontAwesomeSolid"
                           TextColor="{DynamicResource Accent}"
                           FontSize="13"
                           VerticalOptions="Center" />
                    <Label Text="Marcar todas como lidas"
                           TextColor="{DynamicResource Accent}"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MarcarTodasComoLidasCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource Danger}"
                   FontSize="13" />

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <Label Text="Carregando notificações…"
                   IsVisible="{Binding ShowInitialLoading}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Text="Nenhuma notificação por aqui."
                   IsVisible="{Binding ShowEmptyState}"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <RefreshView Command="{Binding LoadNotificacoesCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="NotificacoesCollectionView" ItemsSource="{Binding Notificacoes}" Margin="20,0,20,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:NotificacaoRowViewModel">
                            <Border BackgroundColor="{DynamicResource CardBg}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,8,0,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.AbrirCommand, Source={x:Reference NotificacoesCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                                    <Grid Grid.Column="0" VerticalOptions="Start">
                                        <Border WidthRequest="46"
                                                HeightRequest="46"
                                                StrokeShape="Ellipse"
                                                Stroke="Transparent"
                                                Padding="0"
                                                BackgroundColor="{DynamicResource AccentSoftBg}">
                                            <Label Text="{x:Static helpers:IconFont.Notificacao}"
                                                   FontFamily="FontAwesomeSolid"
                                                   TextColor="{DynamicResource Accent}"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Ponto de não lida -->
                                        <Ellipse WidthRequest="12"
                                                 HeightRequest="12"
                                                 Fill="{DynamicResource DangerSolid}"
                                                 Stroke="{DynamicResource CardBg}"
                                                 StrokeThickness="2"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Start"
                                                 IsVisible="{Binding NaoLida}" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Titulo}"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding QuandoTexto}"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   FontSize="12"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Mensagem}"
                                               TextColor="{DynamicResource TextSecondary}"
                                               FontSize="13" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
