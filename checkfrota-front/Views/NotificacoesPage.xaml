<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:models="clr-namespace:checkfrota_front.Models"
             x:Class="checkfrota_front.Views.NotificacoesPage"
             x:DataType="viewmodels:NotificacoesViewModel"
             Title="Notificações">

    <CollectionView Margin="20" ItemsSource="{Binding Notificacoes}">
        <CollectionView.EmptyView>
            <Label Text="Você não tem notificações." HorizontalOptions="Center" Margin="0,40,0,0" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:NotificacaoItem">
                <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="DodgerBlue" VerticalOptions="Start" IsVisible="{Binding NaoLida}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                            <Label Text="{Binding Descricao}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Horario}" FontSize="11" TextColor="Gray" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>