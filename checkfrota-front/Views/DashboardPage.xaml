<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:checkfrota_front.ViewModels"
             xmlns:shared="clr-namespace:checkfrota_front.Views.Shared"
             xmlns:dashboards="clr-namespace:checkfrota_front.Views.Dashboards"
             xmlns:helpers="clr-namespace:checkfrota_front.Helpers"
             x:Class="checkfrota_front.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBg}"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*">

        <shared:AdminTopBar Grid.Row="0"
                             Title="Dashboard"
                             AvatarUrl="{Binding AvatarUrl}"
                             HasAvatar="{Binding HasAvatar}" />

        <RefreshView Grid.Row="1"
                     Command="{Binding AtualizarCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

                    <!-- Seletor de dashboards: só aparece quando a role tem acesso a mais de um (admin) -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                IsVisible="{Binding MostrarSeletor}">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Opcoes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:DashboardOpcao">
                                    <Border StrokeShape="RoundRectangle 18"
                                            StrokeThickness="1"
                                            Padding="14,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DashboardViewModel}}, Path=SelecionarDashboardCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
                                                <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
                                                <Setter Property="Stroke" Value="{DynamicResource FieldBorder}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Icone}" FontFamily="FontAwesomeSolid" FontSize="13" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Titulo}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource PageBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ContentView IsVisible="{Binding IsFinanceiroSelecionado}">
                        <dashboards:FinanceiroDashboardView BindingContext="{Binding FinanceiroDashboard}" />
                    </ContentView>

                    <ContentView IsVisible="{Binding IsFrotaSelecionado}">
                        <dashboards:FrotaDashboardView BindingContext="{Binding FrotaDashboard}" />
                    </ContentView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
