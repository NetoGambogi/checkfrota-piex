<?xml version="1.0" encoding="UTF-8" ?>
<!-- Paleta do tema escuro. Mesmas chaves de LightTheme.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="checkfrota_front.Resources.Styles.DarkTheme">

    <Color x:Key="PageBg">#0F1115</Color>
    <Color x:Key="CardBg">#1B1E25</Color>
    <Color x:Key="FieldBg">#171A20</Color>
    <Color x:Key="FieldBorder">#2F343E</Color>
    <Color x:Key="Divider">#2A2E37</Color>
    <Color x:Key="HeaderBg">#0A1330</Color>
    <Color x:Key="TabBarBg">#15181E</Color>

    <Color x:Key="TextPrimary">#F1F3F7</Color>
    <Color x:Key="TextSecondary">#9CA3AF</Color>
    <Color x:Key="TextPlaceholder">#6B7280</Color>

    <Color x:Key="Accent">#6573F5</Color>
    <Color x:Key="AccentSoftBg">#23284A</Color>
    <Color x:Key="TabSelected">#FFFFFF</Color>
    <Color x:Key="TabUnselected">#6B7280</Color>

    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="DangerSolid">#DC2626</Color>
    <Color x:Key="DangerSoftBg">#3B1D20</Color>
    <Color x:Key="DangerSoftFg">#F87171</Color>

    <Color x:Key="Success">#4ADE80</Color>
    <Color x:Key="SuccessBg">#14301F</Color>
    <Color x:Key="SuccessSolid">#16A34A</Color>

    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="WarningBg">#3A2F12</Color>

    <!-- Gráficos: séries categóricas (entradas/saídas) validadas para daltonismo; texto usa TextPrimary/TextSecondary -->
    <Color x:Key="ChartEntrada">#3987E5</Color>
    <Color x:Key="ChartSaida">#D95926</Color>
    <Color x:Key="ChartSaldo">#6573F5</Color>
    <Color x:Key="ChartGrid">#2C2C2A</Color>
    <Color x:Key="ChartBaseline">#4A4A46</Color>

</ResourceDictionary>
